{
  "name": "vibelocus",
  "version": "1.0.0",
  "description": "Client-side spatial learning, AI tutor, memory palace indexing, and semantic vector retrieval framework.",
  "license": "AGPL-3.0-only",
  "author": "VibeLocus Contributors",
  "homepage": "https://github.com/vibelocus/vibelocus#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibelocus/vibelocus.git"
  },
  "bugs": {
    "url": "https://github.com/vibelocus/vibelocus/issues"
  },
  "keywords": [
    "ai-tutor",
    "spatial-learning",
    "memory-palace",
    "vector-search",
    "semantic-search",
    "indexeddb",
    "transformers-js",
    "llm",
    "markdown",
    "react",
    "nextjs",
    "client-side-ai"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:lib && npm run build:app",
    "build:lib": "node scripts/build-lib.js",
    "build:app": "next build && node scripts/obfuscate.js",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build:lib",
    "clean": "rm -rf dist .next out coverage"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "lz-string": "^1.5.0",
    "mammoth": "^1.8.0",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "javascript-obfuscator": "^5.4.3",
    "playwright-core": "^1.40.0",
    "typescript": "^5.4.5"
  }
}
